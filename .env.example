# Copy this file to .env. Never put these keys in the n8n workflow JSON.
YUNWU_API_KEY=replace_me
# Set these from your Yunwu API documentation. img-2 image edit is normally a multipart endpoint.
YUNWU_BASE_URL=https://your-yunwu-base-url/v1
YUNWU_IMAGE_EDIT_PATH=/images/edits
YUNWU_IMAGE_GENERATE_PATH=/images/generations
YUNWU_IMAGE_MODEL=img-2

MIMO_API_KEY=replace_me
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# Deployment-only values. Replace these after ClawCloud assigns public domains.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# Generate once and keep unchanged after n8n is in use.
N8N_ENCRYPTION_KEY=replace_with_a_long_random_value
