    {"id":"ocr","name":"PaddleOCR","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[460,300],"parameters":{"method":"POST","url":"http://ocr:8000/ocr","sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"parameterType":"formBinaryData","name":"image","inputDataFieldName":"data"}]},"options":{}}},
    {"id":"normalize","name":"整理 OCR 与模式","type":"n8n-nodes-base.code","typeVersion":2,"position":[690,300],"parameters":{"jsCode":"const input = $input.first().json;\nconst mode = input.mode || 'layout';\nconst blocks = $input.first().json.blocks || [];\nreturn [{ json: { mode, ocr: blocks, originalCopy: input.copy || {}, sourceImage: input.sourceImage || '', layout: input.layout || 'bold' } }];"}},
    {"id":"mode","name":"按模式分流","type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[910,300],"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true},"conditions":[{"leftValue":"={{ $json.mode }}","rightValue":"layout","operator":{"type":"string","operation":"equals"}}]},"renameOutput":true,"outputKey":"只改排版"},{"conditions":{"options":{"caseSensitive":true},"conditions":[{"leftValue":"={{ $json.mode }}","rightValue":"rewrite","operator":{"type":"string","operation":"equals"}}]},"renameOutput":true,"outputKey":"优化文案"},{"conditions":{"options":{"caseSensitive":true},"conditions":[{"leftValue":"={{ $json.mode }}","rightValue":"rebuild","operator":{"type":"string","operation":"equals"}}]},"renameOutput":true,"outputKey":"重做视觉"}]},"options":{}}},
    {"id":"mimo","name":"Mimo 优化文案","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1140,190],"parameters":{"method":"POST","url":"={{ $env.MIMO_BASE_URL + '/chat/completions' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"={{ 'Bearer ' + $env.MIMO_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"json","jsonBody":"={{ JSON.stringify({model: $env.MIMO_MODEL || 'mimo-v2.5', response_format: {type: 'json_object'}, messages: [{role: 'system', content: '只优化营销文案，绝不改变年级、数字、版本、价格、品牌等事实；只输出 JSON: title, subtitle, benefits。'}, {role: 'user', content: JSON.stringify($json.originalCopy)}]}) }}"}},
    {"id":"img2edit","name":"img-2 参考图生图","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1140,410],"parameters":{"method":"POST","url":"={{ $env.YUNWU_BASE_URL + $env.YUNWU_IMAGE_EDIT_PATH }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"={{ 'Bearer ' + $env.YUNWU_API_KEY }}"}]},"sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"name":"model","value":"={{ $env.YUNWU_IMAGE_MODEL || 'img-2' }}"},{"name":"prompt","value":"={{ '以参考图为主题依据，生成无文字的新商业海报背景。删除所有文字、数字、Logo、水印、认证章、品牌标识。' + ($json.mode === 'rebuild' ? '使用全新人物、构图、配色和场景；不复刻参考图。' : '保留主体物、商品信息和整体主题，但重新生成所有像素并为标题与卖点预留干净留白。') }}"},{"parameterType":"formBinaryData","name":"image","inputDataFieldName":"data"}]},"options":{}}},
    {"id":"render","name":"精确中文排版","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1370,410],"parameters":{"method":"POST","url":"http://image-worker:8001/render","sendBody":true,"contentType":"json","jsonBody":"={{ JSON.stringify({background: $json.data?.[0]?.url || $json.url, copy: $json.originalCopy, layout: $json.layout}) }}","options":{"response":{"response":{"responseFormat":"file","outputPropertyName":"data"}}}}},
